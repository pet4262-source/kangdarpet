@import "tailwindcss";


@custom-variant dark (&:is(.dark *));


:root {
  --background: #ffffff;
  --foreground: #111827;

  --primary: #16a34a;
  --primary-foreground: #ffffff;

  --secondary: #f3f4f6;

  --border: #e5e7eb;

  --muted: #6b7280;

  --navy: #0f172a;

  --ring: #16a34a;
}


@theme inline {

  --color-background: var(--background);

  --color-foreground: var(--foreground);

  --color-primary: var(--primary);

  --color-primary-foreground: var(--primary-foreground);

  --color-secondary: var(--secondary);

  --color-border: var(--border);

  --color-muted: var(--muted);

  --color-navy: var(--navy);

  --color-ring: var(--ring);


  --font-sans:
    var(--font-inter),
    ui-sans-serif,
    system-ui,
    sans-serif;


  --font-heading:
    var(--font-manrope),
    var(--font-inter),
    ui-sans-serif,
    sans-serif;
}


* {
  border-color: var(--border);
}


html {
  scroll-behavior: smooth;
}


body {

  background: var(--background);

  color: var(--foreground);

  font-family:
    var(--font-inter),
    ui-sans-serif,
    system-ui,
    sans-serif;

}


h1,
h2,
h3,
h4 {

  font-family:
    var(--font-manrope),
    var(--font-inter),
    ui-sans-serif,
    sans-serif;

}


.container {

  width: 100%;

  margin-left: auto;

  margin-right: auto;

}


img {

  max-width: 100%;

  height: auto;

}
